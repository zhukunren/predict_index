# 上证指数预测服务配置文件。
# 请使用 UTF-8 编码保存。相对路径均相对于本文件所在目录。
# 将本文件复制为 config.ini 后填写令牌和管理员密码；config.ini 应只保留在服务器本地。

[服务]
# 默认仅监听本机。经 HTTPS 反向代理对外部署时，可改为 0.0.0.0。
监听地址 = 127.0.0.1
监听端口 = 8000
# SQLite 数据库、不可变账本和每日归档的根目录。
数据目录 = service_data
# 留空时使用“数据目录/prediction_service.db”；如需其他数据库，可填写完整 SQLAlchemy URL。
数据库URL =
# 首次启动时可从该文件建立第一份发布快照；后续刷新使用 Tushare 数据。
本地特征文件 = market_data/merged_features.csv
历史起始日期 = 20200101
循环验证天数 = 60
# 这是四模型共用的底层基线引擎；启用模型组合后，公开结果由组合版本决定。
正式预测引擎 = state_veto_rule
# 先通过 tools/manage_model_portfolio.py 准备并激活组合，再填写其冻结目录。
# 留空使用原单模型模式。当前组合为期权＋资金流生产模型，以及三个影子模型。
模型组合目录 =
# 填写 Tushare 令牌后，可设为“是”以在交易日的指定时间自动刷新。
启用定时刷新 = 否
刷新小时 = 20
刷新分钟 = 15
# 仅在 HTTPS 反向代理已经正确终止 TLS 时设置为“是”。
Cookie仅HTTPS = 否
# 留空时会在数据目录生成并复用 session_secret.txt，不必手工填写。
会话密钥 =

[管理员]
# 首次启动前填写一个高强度密码。服务只把它的 Argon2 哈希写入数据库。
账号 = admin
密码 =

[Tushare]
# 填写你的 Tushare Pro 令牌；它不会写入归档、公开 CSV 或数据库。
令牌 =
重试次数 = 3
普通重试等待秒数 = 1
限流等待秒数 = 65
# 恒生指数 index_global 接口的连续调用最小间隔，避免触发频率限制。
港股接口最小间隔秒数 = 6.2

[BiLSTM影子]
# 旧 BiLSTM 独立研究入口；新的三个影子模型随生产组合自动运行，不依赖此开关。
启用 = 否
循环验证天数 = 60
# 每隔多少个交易日重训一次；固定间隔保证实时预测与因果回放一致。
重训间隔交易日 = 5
